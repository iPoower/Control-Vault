{
  "name": "control-vault",
  "private": true,
  "version": "0.1.0",
  "description": "Control Vault — stockage, sauvegarde et restauration personnels (PWA).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run security && npm run test:e2e",
    "security": "node scripts/security-check.ts dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.0"
  }
}
